[
  {
    "name": "a1-forbidden-internal-terms",
    "type": "forbidden-phrases",
    "phrases": [
      "portal",
      "BAS",
      "BOSS",
      "工单退回",
      "BAS系统",
      "BOSS系统"
    ],
    "ignoreCase": true,
    "evals": {
      "deny": [
        "请到portal认证页面登录",
        "BAS系统显示未认证",
        "BOSS系统没有扣费记录",
        "工单退回，需重新处理",
        "BAS系统异常"
      ],
      "allow": [
        "请提供学号和手机号，这边为您查询",
        "当前网络正在维护，请您稍后再试",
        "我帮您创建了工单，工单号是12345"
