{
  "name": "dsh-thymus",
  "description": "Constraint governance for DeepSeek Harness agents: mount constraints outside the agent's reach, adjudicate before the action, and prove it with frozen evals",
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "keywords": ["dsh-plugin", "deepseek-harness", "agent", "governance", "evaluation"],
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": ["lib/index.js", "lib/types/**/*.d.ts"],
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-cordis-host-runner": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-llm": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-session": ">=0.1.0-rc.8",
    "@deepseek-ai/dsh-tools": ">=0.1.0-rc.8"
  },
  "dshCompatibility": {
    "requires": ">=0.1.0-rc.8",
    "testedWith": "0.1.0-rc.8",
    "note": "rc.7→rc.8 逐文件核对过 llm/stream、tools 与 cordis-host-runner 的相关路径；更高版本未验"
  }
}
